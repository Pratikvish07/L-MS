# Copy to .env and fill in. Only EXPO_PUBLIC_* values are bundled into the app,
# so never put server secrets here.

# Video upload API. All other app data is static (constants/static-*.ts).
EXPO_PUBLIC_VIDEO_API_BASE_URL=https://nvqf.vocmanindia.com

# Faculty control code lifetime in seconds (a new 6-digit code is shown after each period).
EXPO_PUBLIC_PAIRING_CODE_TTL_SECONDS=30
