# Copy to .env and fill in. Only EXPO_PUBLIC_* values are bundled into the app,
# so never put server secrets here.

# Video file storage API. App data and user profiles are stored in Firebase.
EXPO_PUBLIC_VIDEO_API_BASE_URL=https://nvqf.vocmanindia.com

# Firebase client configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Faculty control code lifetime in seconds (a new 6-digit code is shown after each period).
EXPO_PUBLIC_PAIRING_CODE_TTL_SECONDS=30
